            android:text="29"
            android:textColor="#FFF9ED"
            android:textStyle="bold" />
        <TextView style="@style/CalendarPreviewDay" android:text="30" />
        <TextView style="@style/CalendarPreviewDay" />
        <TextView style="@style/CalendarPreviewDay" />
        <TextView style="@style/CalendarPreviewDay" />
    </GridLayout>
</LinearLayout>
