        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:columnCount="7"
        android:rowCount="6">

        <!-- Weekdays -->
        <TextView style="@style/CalendarPreviewWeekday" android:text="M" />
        <TextView style="@style/CalendarPreviewWeekday" android:text="T" />
