        <TextView style="@style/CalendarPreviewWeekday" android:text="T" />
        <TextView style="@style/CalendarPreviewWeekday" android:text="F" />
        <TextView style="@style/CalendarPreviewWeekday" android:text="S" />
        <TextView style="@style/CalendarPreviewWeekday" android:text="S" />

        <!-- Days -->
        <TextView style="@style/CalendarPreviewDay" />
        <TextView style="@style/CalendarPreviewDay" />
        <TextView style="@style/CalendarPreviewDay" android:text="1" />
        <TextView style="@style/CalendarPreviewDay" android:text="2" />
        <TextView style="@style/CalendarPreviewDay" android:text="3" />
        <TextView style="@style/CalendarPreviewDay" android:text="4" />
        <TextView style="@style/CalendarPreviewDay" android:text="5" />
        <TextView style="@style/CalendarPreviewDay" android:text="6" />
        <TextView style="@style/CalendarPreviewDay" android:text="7" />
        <TextView style="@style/CalendarPreviewDay" android:text="8" />
        <TextView style="@style/CalendarPreviewDay" android:text="9" />
        <TextView style="@style/CalendarPreviewDay" android:text="10" />
        <TextView style="@style/CalendarPreviewDay" android:text="11" />
        <TextView style="@style/CalendarPreviewDay" android:text="12" />
        <TextView style="@style/CalendarPreviewDay" android:text="13" />
        <TextView style="@style/CalendarPreviewDay" android:text="14" />
        <TextView style="@style/CalendarPreviewDay" android:text="15" />
        <TextView style="@style/CalendarPreviewDay" android:text="16" />
        <TextView style="@style/CalendarPreviewDay" android:text="17" />
        <TextView style="@style/CalendarPreviewDay" android:text="18" />
        <TextView style="@style/CalendarPreviewDay" android:text="19" />
        <TextView style="@style/CalendarPreviewDay" android:text="20" />
        <TextView style="@style/CalendarPreviewDay" android:text="21" />
        <TextView style="@style/CalendarPreviewDay" android:text="22" />
        <TextView style="@style/CalendarPreviewDay" android:text="23" />
        <TextView style="@style/CalendarPreviewDay" android:text="24" />
        <TextView style="@style/CalendarPreviewDay" android:text="25" />
