{
  "expo": {
    "name": "Hijra",
    "slug": "hijra",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hijra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doukouss.hijra"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.doukouss.hijra",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/foreground-icon.png",
        "backgroundImage": "./assets/images/background-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FEEBD0",
          "dark": {
            "backgroundColor": "#FEEBD0"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Oldenburg/Oldenburg-Regular.ttf",
            "./assets/fonts/Oleo_Script/OleoScript-Bold.ttf",
            "./assets/fonts/Oleo_Script/OleoScript-Regular.ttf",
            "./assets/fonts/Open_Sans/OpenSans-Bold.ttf",
            "./assets/fonts/Open_Sans/OpenSans-Light.ttf",
            "./assets/fonts/Open_Sans/OpenSans-Medium.ttf",
            "./assets/fonts/Open_Sans/OpenSans-Regular.ttf",
            "./assets/fonts/Open_Sans/OpenSans-SemiBold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73adef44-9df7-4d72-88a9-63ce67607add"
      }
    },
    "owner": "doukouss",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/73adef44-9df7-4d72-88a9-63ce67607add"
    }
  }
}
